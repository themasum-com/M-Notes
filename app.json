{
  "expo": {
    "name": "M Notes",
    "slug": "m-notes",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mnotes.secure",
      "infoPlist": {
        "NSFaceIDUsageDescription": "M Notes uses biometric authentication to protect your private notes."
      }
    },
    "android": {
      "package": "com.mnotes.secure",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FED766",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow M Notes to use Face ID to securely unlock your notes."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FED766"
        }
      ]
    ]
  }
}
